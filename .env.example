# Copiez ce fichier en ".env" (à la racine du projet) et complétez les valeurs.
# Le fichier .env ne doit jamais être commité (voir .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=change-moi-en-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- E-mail (formulaire de contact + newsletter) ---
# Exemple pour Gmail : activez la validation en 2 étapes sur le compte Gmail
# puis générez un "mot de passe d'application" (https://myaccount.google.com/apppasswords)
# à utiliser dans MAIL_PASS (ne mettez jamais le mot de passe principal du compte).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USER=votre-adresse@gmail.com
MAIL_PASS=mot-de-passe-application-gmail
# Adresse qui reçoit les messages du site. Si non renseignée, MAIL_USER est utilisé.
MAIL_TO=contact@vicetogo.org
