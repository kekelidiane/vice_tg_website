# Adresse Gmail utilisée pour envoyer les mails (contact + newsletter)
MAIL_USER=votre-adresse@gmail.com

# Mot de passe d'application Gmail (PAS le mot de passe du compte) :
# https://myaccount.google.com/apppasswords - nécessite la validation
# en 2 étapes activée sur le compte Google.
MAIL_PASS=xxxxxxxxxxxxxxxx

# Adresse qui reçoit les messages (par défaut : la même que MAIL_USER)
MAIL_TO=contact@vicetogo.org
